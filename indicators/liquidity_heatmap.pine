//@version=5
indicator("Open Liquidity Heatmap [Improved]", "Liq Heatmap v2", overlay = true, max_bars_back = 5000, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_polylines_count = 100)

// ─── Inputs ──────────────────────────────────────────────────────────────────
var string GS = "Settings"
var string GD = "Display"

back  = input.int   (200,    "Lookback",            minval = 50, maxval = 500, group = GS, tooltip = "Number of bars to analyze")
lvgr  = input.float (4.5,    "Leverage %",          minval = 0.1, maxval = 20, step = 0.01, group = GS, tooltip = "Distance from price as % for liquidation zones")
step  = input.int   (250,    "Levels",              minval = 50, maxval = 250, group = GS)
offs  = input.string("Auto", "Offset",              options = ["Auto", "Manual"], group = GS)
ofle  = input.int   (100,    "",                    minval = 10, inline = "o", group = GS)

disP  = input.bool  (true,   "POC Line",            group = GD)
pocC  = input.color (#13dffa,"",                    inline = "5", group = GD)
pocW  = input.int   (4,      "",                    minval = 1, maxval = 10, inline = "5", group = GD)

disV  = input.bool  (true,   "Volume Profile",      group = GD)
vpC   = input.color (#434651,"",                    inline = "6", group = GD)

VPL   = input.bool  (true,   "Liq Volume Profile",  group = GD)
VPUP  = input.color (#006446,"",                    inline = "7", group = GD)
VPDN  = input.color (#801922,"",                    inline = "7", group = GD)

disR  = input.bool  (true,   "Resting Liquidity",   group = GD)
disL  = input.bool  (true,   "Range Lines",         group = GD)

// v2: New inputs
show_dist = input.bool  (true,  "Show Distance to POC", group = GD, tooltip = "Display distance from current price to POC")
show_pct  = input.bool  (true,  "Show POC as %",        group = GD, tooltip = "Display POC percentage from current price")
min_vol   = input.float (0.0,   "Min Volume Filter %",  minval = 0.0, maxval = 50, step = 0.5, group = GS, tooltip = "Hide levels with volume below this % of max")

// ─── Calculations ────────────────────────────────────────────────────────────
lvgr_pct = lvgr / 100.0
hs       = ta.highest(back) * (1 + lvgr_pct)
ls       = ta.lowest (back) * (1 - lvgr_pct)
diff     = (hs - ls) / step

// ─── Cleanup on last bar ─────────────────────────────────────────────────────
if barstate.islast
    for obj in line.all
        obj.delete()
    for obj in polyline.all
        obj.delete()
    for obj in label.all
        obj.delete()
    for obj in box.all
        obj.delete()

    // ─── Store type ──────────────────────────────────────────────────────
    type store
        array<line>        ln
        array<float>       hm
        map<float, float>  vp
        float              lH
        float              lL
        float              lvl

    var store cls = store.new(array.new<line>(step, line(na)), array.new<float>(step, 0.0), map.new<float, float>(), high, low, hs)

    // ─── Range lines ─────────────────────────────────────────────────────
    cp  = array.new<chart.point>()
    cp1 = array.new<chart.point>()

    if disL
        cp.unshift (chart.point.from_time(time[back], hs + diff))
        cp.unshift (chart.point.from_time(time[back], ls))
        cp1.unshift(chart.point.from_time(time, hs + diff))
        cp1.unshift(chart.point.from_time(time, ls))

        polyline.new(cp,  line_color = color.white,        xloc = xloc.bar_time, force_overlay = true)
        polyline.new(cp1, line_color = color.new(chart.fg_color, 50), xloc = xloc.bar_time, force_overlay = true, line_style = line.style_dotted)

    // ─── Build grid levels ───────────────────────────────────────────────
    for i = 0 to step - 1
        float plotter = i == 0 ? hs : hs - diff * i
        cls.ln.set(i, line.new(x1 = time[back], x2 = time, y1 = plotter, y2 = plotter, color = na, xloc = xloc.bar_time, width = 4))
        cls.vp.put(plotter, 0.0)

    // ─── Core heatmap + volume profile calculation ───────────────────────
    // Optimization: pre-calculate grid Y values once
    float[] gridY = array.new<float>(step, 0.0)
    for i = 0 to step - 1
        array.set(gridY, i, i == 0 ? hs : hs - diff * i)

    // Single-pass accumulation
    for i = 0 to back
        float lo_i = low[i]
        float hi_i = high[i]
        float vol_i = volume[i]

        for x = 0 to step - 2
            float cL = array.get(gridY, x)
            float nL = array.get(gridY, x + 1)

            // Volume Profile: candle crosses the grid level
            if lo_i <= cL and hi_i >= nL
                cls.vp.put(cL, cls.vp.get(cL) + vol_i)

            // Liquidation heatmap
            float lP = lo_i * (1 - lvgr_pct)
            float hP = hi_i * (1 + lvgr_pct)

            if lP < cls.lL and lo_i < cls.lL
                cls.lL := lo_i
            if hP > cls.lH and hi_i > cls.lH
                cls.lH := hi_i

            if lP < cls.lL and lP >= nL and lP <= cL
                cls.hm.set(x, cls.hm.get(x) + vol_i)
            if hP > cls.lH and hP >= nL and hP <= cL
                cls.hm.set(x, cls.hm.get(x) + vol_i)

    // ─── Render ──────────────────────────────────────────────────────────
    float[] heat = cls.hm
    float[] volt = cls.vp.values()
    int    pocL  = na
    float  pocPrice = na
    float  maxHeat = heat.max()

    // Find POC
    int maxIdx = heat.indexof(maxHeat)
    pocPrice := array.get(gridY, maxIdx)
    pocL     := disP ? math.round((offs == "Auto" ? back / 2 : ofle) * maxHeat / maxHeat) : na

    for i = 0 to step - 2
        line ln  = cls.ln.get(i)
        line lx  = cls.ln.get(i + 1)
        float hv = heat.get(i)
        float vv = volt.get(i)

        // Min volume filter
        float volPct = maxHeat > 0 ? (hv / maxHeat) * 100 : 0
        bool  show   = volPct >= min_vol

        int   ancor = math.round((offs == "Auto" ? back / 2 : ofle) * hv / maxHeat)

        color bC = show ? color.from_gradient(hv, 0, maxHeat, #ffffff00, close > ln.get_y2() ? VPUP : VPDN) : na
        color gC = show ? color.from_gradient(hv, 0, maxHeat, #ffffff00, close < ln.get_y2() ? VPDN : VPUP) : na
        color vC = color.from_gradient(vv, volt.min(), volt.max(), chart.bg_color, vpC)

        if disR and show
            ln.set_color(gC)

        if VPL and show
            box.new(
                 top    = lx.get_y2() + diff + diff / 2,
                 bottom = lx.get_y2() + diff / 2,
                 left   = time,
                 right  = time + (time - time[1]) * ancor,
                 bgcolor      = bC,
                 border_color = bC,
                 xloc         = xloc.bar_time)

        if disV
            int vpcim = math.round((offs == "Auto" ? back / 2 : ofle) * vv / volt.max())
            box.new(
                 top    = ln.get_y2(),
                 bottom = lx.get_y2(),
                 left   = time[back + vpcim],
                 right  = time[back],
                 bgcolor      = vC,
                 border_color = vC,
                 xloc         = xloc.bar_time)

    // ─── POC line + labels ───────────────────────────────────────────────
    if disP and not na(pocL)
        avg = math.avg(
             array.get(gridY, maxIdx),
             array.get(gridY, math.min(maxIdx + 1, step - 1)))

        line.new(
             x1    = time[back],
             x2    = time + (time - time[1]) * pocL,
             y1    = avg + diff / 2,
             y2    = avg + diff / 2,
             color     = pocC,
             xloc      = xloc.bar_time,
             width     = pocW,
             force_overlay = true)

        // POC label
        string pocText = "POC | " + str.tostring(math.round(avg, 2))
        if show_pct
            pocText += " (" + str.tostring(math.round((avg - close) / close * 100, 1)) + "%)"
        if show_dist
            pocText += "\nDist: " + str.tostring(math.round(math.abs(avg - close), 2))

        label.new(
             x         = time + (time - time[1]) * pocL,
             y         = avg + diff / 2,
             textcolor = pocC,
             color     = color.new(pocC, 80),
             style     = label.style_label_left,
             size      = size.normal,
             text      = pocText,
             xloc      = xloc.bar_time)

        label.new(
             x    = time + (time - time[1]) * pocL,
             y    = avg + diff / 2,
             color     = pocC,
             style = label.style_circle,
             size  = size.tiny,
             xloc  = xloc.bar_time,
             force_overlay = true)

    // ─── Info table ──────────────────────────────────────────────────────
    var table infoTable = table.new(position.top_right, 2, 5, bgcolor = color.new(chart.bg_color, 10), border_width = 1)
    if barstate.islast
        table.cell(infoTable, 0, 0, "POC",       text_color = pocC, text_size = size.small)
        table.cell(infoTable, 1, 0, str.tostring(math.round(pocPrice, 2)), text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 1, "Distance",   text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 1, str.tostring(math.round(math.abs(pocPrice - close), 2)) + " (" + str.tostring(math.round((pocPrice - close) / close * 100, 1)) + "%)", text_color = pocPrice > close ? VPUP : VPDN, text_size = size.small)
        table.cell(infoTable, 0, 2, "High Range", text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 2, str.tostring(math.round(hs, 2)), text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 3, "Low Range",  text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 3, str.tostring(math.round(ls, 2)), text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 0, 4, "Levels",     text_color = chart.fg_color, text_size = size.small)
        table.cell(infoTable, 1, 4, str.tostring(step), text_color = chart.fg_color, text_size = size.small)
