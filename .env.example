# ==============================================
# Telegram Bot
# ==============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=-1000000000000
#TELEGRAM_ADMIN_IDS=123456789,987654321

# ==============================================
# Exchange API
# ==============================================
EXCHANGE=bingx
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Тип рынка для OHLCV:
#   spot  — спотовая торговля
#   swap  — perpetual futures (BingX USDT-M, Bybit)
#   future — expiring futures (Binance)
MARKET_TYPE=swap

# ==============================================
# Trading settings
# ==============================================
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
PRIMARY_TIMEFRAMES=1h,4h
CONFIRM_TIMEFRAME=15m

# ==============================================
# v2.5 — Signal Quality Gates
# ==============================================
# Probability filter: min P(TP) to pass gate (0.0=off, 0.30=conservative start)
MIN_P_TP=0.30
# OB retest history: candles to scan backward for retest confirmation
OB_RETEST_HISTORY=30
# OB mitigation buffer: % penetration to consider mitigated
OB_MITIGATION_BUFFER_PCT=0.3
# OB max age: candles before OB is considered expired
OB_MAX_AGE_CANDLES=35
# Max OB distance from entry (%)
MAX_OB_DISTANCE_PCT=3.0
# Session filter: hard gate outside kill zones
SESSION_HARD_GATE=true
# Trading sessions (UTC): london,ny
TRADING_SESSIONS=london,ny
# Cooldown mode: strict (classic) | ob_aware (reduced cooldown for OB retests)
COOLDOWN_MODE=ob_aware
# Max distance (%) between two OB midpoints to consider them "the same OB"
OB_PROXIMITY_PCT=0.5

# ==============================================
# v2.5 — Direction Filters
# ==============================================
# Block SHORT signals when HTF bias is bullish (no edge)
BLOCK_SHORT_IN_BULLISH_HTF=true
# Block LONG signals when HTF bias is bearish (no edge)
BLOCK_LONG_IN_BEARISH_HTF=true
# Minimum P(TP) for SHORT signals (higher threshold = stricter)
MIN_P_TP_SHORT=0.40
# Minimum P(TP) for REVERSAL signals (highest threshold = strictest)
MIN_P_TP_REVERSAL=0.50

# ==============================================
# v2.6 — Breakout Quality (AMD sweep vs real breakout)
# ==============================================
# Enable the breakout-quality classifier
BREAKOUT_QUALITY_ENABLED=true
# Hard gate: block signals classified as AMD fake-break (off = shadow log only)
BREAKOUT_QUALITY_HARD_GATE=false
# Minimum "real" score to pass the hard gate
BREAKOUT_QUALITY_MIN_SCORE=45
# Settled range lookback (candles) for the boundary
BREAKOUT_QUALITY_LOOKBACK=40

# ==============================================
# Database
# ==============================================
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ==============================================
# Indicator parameters (defaults shown — synced with config/settings.py)
# ==============================================
EMA_FAST=8
EMA_SLOW=21
EMA_TREND=55
RSI_PERIOD=10
RSI_OVERBOUGHT=72
RSI_OVERSOLD=28
RSI_BULL_MIN=55
RSI_BEAR_MAX=45
MACD_FAST=8
MACD_SLOW=21
MACD_SIGNAL=5
ADX_PERIOD=14
ADX_MIN=20
ADX_STRONG=22
ATR_PERIOD=14
ATR_MULTIPLIER_SL=1.5
ATR_MULTIPLIER_TP=3.0
MIN_SL_DISTANCE_PCT=1.0
MAX_SL_DISTANCE_PCT=10.0
STOP_HUNT_BUFFER_PCT=0.5
MAX_OB_DISTANCE_PCT=3.0
MIN_RR_THRESHOLD=1.5
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=2.5
VOLUME_FACTOR=1.5
VOLUME_SMA_PERIOD=20
CANDLES_LIMIT=200
COMPRESSION_VOLUME_FACTOR=2.0

# ==============================================
# Filter toggles — signal engine gates
# ==============================================
EMA_SLOPE_CHECK=false
MACD_SLOPE_CHECK=false
ADX_FILTER_ENABLED=true
EMA_ALIGNMENT_ENABLED=true
EMA_SPREAD_ENABLED=true
TRIGGER_REQUIRED=true
CANDLE_CLOSE_ENABLED=true
MIN_SCORE_ENABLED=true
COMPRESSION_ENABLED=true

# ==============================================
# Market Structure
# ==============================================
DISTANCE_FILTER_MIN_PCT=1.2
MTF_ENABLED=true
MTF_REQUIRED_ALIGNMENT=2
MTF_TIMEFRAMES=1d,4h,1h

# ==============================================
# Derivatives
# ==============================================
FUNDING_STRONG_THRESHOLD=0.0003
FUNDING_NEUTRAL_ZONE=0.0001
OI_MODERATE_THRESHOLD=0.5
OI_STRONG_THRESHOLD=2.0
OI_LOOKBACK_HOURS=24
BTC_SYMBOL=BTC/USDT
BTC_EMA200_TIMEFRAME=4h
BTC_CORRELATION_ENABLED=true
ETH_SYMBOL=ETH/USDT
ETH_CORRELATION_SYMBOLS=OP/USDT,ARB/USDT
ETH_CORRELATION_ENABLED=true

# ==============================================
# Risk & Volatility
# ==============================================
VOLATILITY_LOW_THRESHOLD=0.8
VOLATILITY_HIGH_THRESHOLD=6.0
VOLATILITY_ATR_PERIOD=14
RISK_STRONG_PCT=1.0
RISK_MODERATE_PCT=0.5
MIN_SCORE_FOR_SIGNAL=2
RISK_WEAK_TRADE=false
RISK_WEAK_PCT=0.25
NO_TRADE_MIN_ATR_PCT=0.6

# ==============================================
# Context
# ==============================================
CONTEXT_MIN_VERDICT=WEAK

# ==============================================
# Scoring
# ==============================================
QUALITY_STRONG_THRESHOLD=65
QUALITY_MODERATE_THRESHOLD=40

# ==============================================
# Web Dashboard
# ==============================================
WEB_ENABLED=true
WEB_PORT=3002
WEB_HOST=0.0.0.0
WEB_UPDATE_INTERVAL=5

# ==============================================
# Elliott Wave (soft feature — never blocks signals)
# ==============================================
WAVE_ANALYSIS_ENABLED=false
WAVE_MIN_CONFIDENCE=0.4
WAVE_CONFLICT_PENALTY=0.85
WAVE_WEIGHT=1.0
WAVE_MAX_ALTERNATIVES=3
WAVE_MIN_SWING_ATR=0.5
WAVE_MAX_LOOKBACK=200
