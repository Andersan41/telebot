# ==============================================
# Telegram Bot
# ==============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=-1000000000000
#TELEGRAM_ADMIN_IDS=123456789,987654321

# ==============================================
# Exchange API (Binance)
# ==============================================
EXCHANGE=binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Тип рынка для OHLCV (spot | future).
# ⚠️ Funding rate / OI / L-S всегда читаются с fapi.binance.com независимо от этой настройки.
MARKET_TYPE=spot

# ==============================================
# Trading settings
# ==============================================
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
PRIMARY_TIMEFRAMES=1h,4h
CONFIRM_TIMEFRAME=15m

# ==============================================
# Database
# ==============================================
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ==============================================
# Indicator parameters (defaults shown)
# ==============================================
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
RSI_BULL_MIN=50
RSI_BEAR_MAX=50
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ADX_PERIOD=14
ADX_MIN=25
ATR_PERIOD=14
ATR_MULTIPLIER_SL=1.5
ATR_MULTIPLIER_TP=3.0
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3.0
VOLUME_FACTOR=1.2
VOLUME_SMA_PERIOD=20
CANDLES_LIMIT=200

# ==============================================
# Market Structure (Phase 1 improvements)
# ==============================================
DISTANCE_FILTER_MIN_PCT=1.5
MTF_ENABLED=true
MTF_REQUIRED_ALIGNMENT=2
MTF_TIMEFRAMES=1d,4h,1h

# ==============================================
# Derivatives (Phase 3 improvements)
# ==============================================
FUNDING_STRONG_THRESHOLD=0.03
FUNDING_NEUTRAL_ZONE=0.01
OI_MODERATE_THRESHOLD=0.5
OI_STRONG_THRESHOLD=2.0
OI_LOOKBACK_HOURS=24
BTC_SYMBOL=BTC/USDT
BTC_EMA200_TIMEFRAME=4h
BTC_CORRELATION_ENABLED=true
ETH_SYMBOL=ETH/USDT
ETH_CORRELATION_SYMBOLS=OP/USDT,ARB/USDT
ETH_CORRELATION_ENABLED=true

# ==============================================
# Risk & Volatility (Phase 4 improvements)
# ==============================================
VOLATILITY_LOW_THRESHOLD=1.0
VOLATILITY_HIGH_THRESHOLD=4.0
VOLATILITY_ATR_PERIOD=14
RISK_STRONG_PCT=1.0
RISK_MODERATE_PCT=0.5
RISK_WEAK_TRADE=false
NO_TRADE_MIN_ATR_PCT=0.5
